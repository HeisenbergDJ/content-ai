MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=contentai

# ─── API Key 加密主密钥 ──────────────────────────────────────────────────────
# 用于加密租户的 BYOK API Key，必须是 64 位十六进制字符串（32 字节）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 警告：一旦设置不可更改，否则已加密的 Key 将无法解密
ENCRYPTION_KEY=

# ─── 文件存储（本地模式）─────────────────────────────────────────────────────
# 文件保存在 public/uploads/，通过 /uploads/<filename> 直接访问
# 留空时默认使用 <project_root>/public/uploads
UPLOAD_DIR=public/uploads/

# ─── 文件存储（OSS 模式，未来启用）─────────────────────────────────────────
# OSS_PROVIDER=aliyun          # aliyun | aws | tencent
# OSS_BUCKET=your-bucket-name
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=your-key-id
# OSS_ACCESS_KEY_SECRET=your-key-secret
# OSS_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
